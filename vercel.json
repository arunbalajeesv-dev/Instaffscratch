{
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.shyfton.in"
        }
      ],
      "destination": "https://shyfton.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "instaffscratch.vercel.app"
        }
      ],
      "destination": "https://shyfton.in/$1",
      "permanent": false
    }
  ]
}
